{
  "manifest_version": 3,
  "name": "FullPage Screen Capture & Crop",
  "version": "1.0.0",
  "description": "Chụp toàn bộ trang web (Full Page Scrolling Capture) và cắt ảnh (Crop), tải PNG, JPG, PDF miễn phí.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    },
    "default_title": "Chụp ảnh màn hình"
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "unlimitedStorage",
    "downloads"
  ],
  "host_permissions": [
    "<all_urls>"
  ]
}